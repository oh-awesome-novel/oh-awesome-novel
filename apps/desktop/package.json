{
  "name": "@oh-awesome-novel/desktop",
  "productName": "oan",
  "private": true,
  "version": "0.0.0",
  "description": "Filesystem-first novel IDE and AI writing copilot",
  "license": "MIT",
  "author": "oh-awesome-novel",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm --prefix ../.. run desktop:build:deps && electron-forge start",
    "package": "npm --prefix ../.. run desktop:build:package && electron-forge package",
    "make": "npm --prefix ../.. run desktop:build:package && electron-forge make",
    "publish": "npm --prefix ../.. run desktop:build:package && electron-forge publish",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/get": "^5.1.0",
    "@oh-awesome-novel/forge-plugin-tsdown": "^0.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "40.10.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@oh-awesome-novel/backend": "^0.0.1",
    "@oh-awesome-novel/core": "^0.0.1",
    "@oh-awesome-novel/tools": "^0.0.1",
    "electron-squirrel-startup": "^1.0.1"
  }
}
