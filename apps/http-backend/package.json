{
  "name": "@oh-awesome-novel/http-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone local HTTP backend launcher for Electron-free testing.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "nx run @oh-awesome-novel/backend:build",
    "build": "vp pack",
    "dev": "nx run @oh-awesome-novel/backend:build && vp pack && node dist/index.mjs",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@oh-awesome-novel/backend": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vite-plus": "1.4.0"
  }
}
