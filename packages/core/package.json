{
  "name": "@oh-awesome-novel/core",
  "version": "0.0.1",
  "description": "Core library for oh-awesome-novel: workspace init, LLM provider config, and novel domain types.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "vp pack",
    "test": "npm run test:run --workspace @oh-awesome-novel/test-core",
    "test:watch": "npm run test --workspace @oh-awesome-novel/test-core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vite-plus": "1.4.0"
  },
  "exports": {
    "./chapter-review-contract": { "types": "./dist/chapter-review-contract.d.mts", "import": "./dist/chapter-review-contract.mjs" },
    "./play-chapter-writing-contract": { "types": "./dist/play-chapter-writing-contract.d.mts", "import": "./dist/play-chapter-writing-contract.mjs" },
    "./play-crossover": { "types": "./dist/play-crossover.d.mts", "import": "./dist/play-crossover.mjs" },
    "./novel-copilot-contract": {
      "types": "./dist/novel-copilot-contract.d.mts",
      "import": "./dist/novel-copilot-contract.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./play-event-evidence": {
      "types": "./dist/play-event-evidence.d.mts",
      "import": "./dist/play-event-evidence.mjs"
    },
    "./agent-usage": {
      "types": "./dist/agent-usage.d.mts",
      "import": "./dist/agent-usage.mjs"
    },
    "./text-speaker-parser": {
      "types": "./dist/text-speaker-parser.d.mts",
      "import": "./dist/text-speaker-parser.mjs"
    },
    "./novel-lint-rules": {
      "types": "./dist/novel-lint-rules.d.mts",
      "import": "./dist/novel-lint-rules.mjs"
    },
    "./play-turn-choices": {
      "types": "./dist/play-turn-choices.d.mts",
      "import": "./dist/play-turn-choices.mjs"
    }
  }
}
