{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "outDir": "dist",
    "lib": [
      "dom",
      "ES2022"
    ],
    "inlineSourceMap": true,
    "rootDir": "src",
    "experimentalDecorators": true,
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "composite": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "index.ts",
    "spec",
    "tmpl",
    "vite.config.ts"
  ]
}
